# Admin Account
# Salted SHA-256 hash for the admin password. Generate with:
#   backend/scripts/hash.sh yourpassword
# Format: SALT$HASH (both hex). If unset, defaults to SHA-256 of 'admin' (no salt).
ADMIN_PASSWORD_HASH=

# Prowlarr Configuration
PROWLARR_API_KEY=your_prowlarr_key
PROWLARR_BASE_URL=http://prowlarr:9696

# Autobrr Configuration
AUTOBRR_API_KEY=your_autobrr_key
AUTOBRR_BASE_URL=http://autobrr:7474

# Apprise API endpoint (e.g. http://192.168.41.4:8084)
APPRISE_API_URL=
# Apprise notification URLs (comma-separated, e.g. ntfy://host/topic?token=...)
APPRISE_URLS=
# Minimum downtime (minutes) before an Apprise alert fires. 0 = immediate.
ALERT_DELAY_MINUTES=0

# qBittorrent Configuration
QBITTORRENT_BASE_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=admin
QBITTORRENT_POLL_INTERVAL_S=300
