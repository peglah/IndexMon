# Admin Account
# Bcrypt hash for the admin password. Generate with:
#   scripts/hash.sh yourpassword
# If unset, a random password is generated and printed to logs.
# IMPORTANT: Enclose the hash in single quotes to prevent Docker Compose from
# expanding $ signs as variable references. Example:
#   ADMIN_PASSWORD_HASH='$2a$10$...'
ADMIN_PASSWORD_HASH=

# Prowlarr Configuration
PROWLARR_API_KEY=your_prowlarr_key
PROWLARR_BASE_URL=http://prowlarr:9696

# Autobrr Configuration
#AUTOBRR_API_KEY=your_autobrr_key
#AUTOBRR_BASE_URL=http://autobrr:7474

# Apprise notification URLs (comma-separated, e.g. ntfy://host/topic?token=...)
#APPRISE_URLS=
# Minimum downtime (minutes) before an Apprise alert fires. 0 = immediate.
#ALERT_DELAY_M=0

# qBittorrent Configuration
#QBITTORRENT_BASE_URL=http://qbittorrent:8080
#QBITTORRENT_USERNAME=admin
#QBITTORRENT_PASSWORD=admin
#QBITTORRENT_POLL_INTERVAL_S=300

# Indexer polling
# Prowlarr/Autobrr status poll interval in seconds (independent of the frontend).
# Default: 60
#INDEXER_POLL_INTERVAL_S=60

# Tracker Stats (per-indexer buffer/ratio from UNIT3D APIs)
# Pulls API keys from Prowlarr indexer config automatically.
# TTL in minutes. Set to 0 to disable. Default: 1440 (24h).
#TRACKER_STATS_TTL_M=1440

# General
# Log level: debug, info, warn, error. Default: info
#LOG_LEVEL=info
# Backend listen port. Default: 3000
#PORT=3000
# SQLite database file path. Default: /app/data/indexmon.db
#DB_PATH=/app/data/indexmon.db
